NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_f5xRg0xqH1_SB-6wWZKTtQ_PHOTotI4
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdpbmhndWV1Y3ZhcXhocGhwbG15Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQyNzExNjYsImV4cCI6MjA5OTg0NzE2Nn0.uiO_SbfMrkvdiQWtlXd7VFDzdTZO4AasVSVohgd9AsU

