# Copy into Hostinger / .env.local (do not commit secrets)
# Project: https://supabase.com/dashboard/project/ginhgueucvaqxhphplmy
#
# Canonical, Open Graph, sitemap, and robots are hardcoded to
# https://metric.graphics. NEXT_PUBLIC_SITE_URL is ignored for SEO
# (Hostinger production env cannot be changed). Staging host
# metric.nocode.uz stays noindex via X-Robots-Tag on that Host.

NEXT_PUBLIC_CONTACT_EMAIL=hello@metric.agency

# Runtime server prefers SUPABASE_* (not NEXT_PUBLIC_*) so Hostinger env wins
SUPABASE_URL=https://ginhgueucvaqxhphplmy.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://ginhgueucvaqxhphplmy.supabase.co

SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=
SUPABASE_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

CMS_BOOTSTRAP_SECRET=
CMS_ADMIN_EMAIL=admin@minim.uz
CMS_ADMIN_PASSWORD=change-me-strong-password

# Resend — lead emails after /api/leads (from no-reply@metric.graphics).
# Verify metric.graphics in https://resend.com/domains
# Default recipients: submitter + minimdesigngroup@gmail.com
RESEND_API_KEY=
# RESEND_FROM=METRIC <no-reply@metric.graphics>
# RESEND_NOTIFY_TO=minimdesigngroup@gmail.com
