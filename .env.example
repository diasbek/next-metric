# -----------------------------------------------------------------------------
# Local templates — copy secrets only into gitignored files:
#   .env.local              → local / Hostinger-like (points at prod Supabase)
#   .env.production.local   → production — Hostinger panel too
# -----------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL=https://metric.nocode.uz
NEXT_PUBLIC_CONTACT_EMAIL=hello@metric.agency

# SEO: auto-index on production builds.
# Local / preview: leave unset or set false.
# NEXT_PUBLIC_ALLOW_INDEXING=false

# Analytics (leave empty to disable)
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Search engine verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# Supabase — minim prod (shared with next-timsol)
# Project ref: ginhgueucvaqxhphplmy
# Dashboard: https://supabase.com/dashboard/project/ginhgueucvaqxhphplmy
# API keys:   https://supabase.com/dashboard/project/ginhgueucvaqxhphplmy/settings/api-keys
# Metric tables: metric_*  |  Timsol tables: unprefixed
# Buckets: metric-media, lead-attachments, site-files
# Migrations: npm run db:migrate  OR SQL Editor:
#   supabase/migrations/20260810120000_metric_prefixed_schema.sql
#   supabase/migrations/20260810130000_metric_storage_buckets.sql
# Check: npm run check:metric-env
# -----------------------------------------------------------------------------
