# -----------------------------------------------------------------------------
# Local templates — copy secrets only into gitignored files:
#   .env.local              → local / Hostinger-like (points at prod Supabase)
#   .env.production.local   → production (metric.agency) — Hostinger panel too
# -----------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL=https://metric.agency
NEXT_PUBLIC_CONTACT_EMAIL=hello@metric.agency

# SEO: auto-index on metric.agency production builds.
# Local / preview: leave unset or set false.
# NEXT_PUBLIC_ALLOW_INDEXING=false

# Analytics (leave empty to disable)
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Search engine verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=

# Supabase (prod)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Secret key (server / scripts only — never NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=
SUPABASE_API_KEY=

# Publishable / anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: bootstrap first owner via /admin/setup/
CMS_BOOTSTRAP_SECRET=

# Optional: CLI admin
# CMS_ADMIN_EMAIL=you@example.com
# CMS_ADMIN_PASSWORD=

# Optional: psql migrations
# DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
