# -----------------------------------------------------------------------------
# Local templates — copy secrets only into gitignored files:
#   .env.local              → local / Hostinger-like (points at prod Supabase)
#   .env.production.local   → production (metric.agency) — Hostinger panel too
# -----------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL=https://metric.agency
NEXT_PUBLIC_CONTACT_EMAIL=hello@metric.agency

# SEO: auto-index on metric.agency production builds.
# Local / preview: leave unset or set false.
# NEXT_PUBLIC_ALLOW_INDEXING=false

# Analytics (leave empty to disable)
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Search engine verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# Supabase — Metric project
# Project ref: dksqshrlnmtabrsuyyoz
# Dashboard: https://supabase.com/dashboard/project/dksqshrlnmtabrsuyyoz
# API keys:   https://supabase.com/dashboard/project/dksqshrlnmtabrsuyyoz/settings/api
# Tables: metric_*  |  Buckets: metric-media, lead-attachments, site-files
# Migrations (fresh): 20260810120000_metric_prefixed_schema.sql
#                     20260810130000_metric_storage_buckets.sql
# Check: npm run check:metric-env
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://dksqshrlnmtabrsuyyoz.supabase.co
SUPABASE_URL=https://dksqshrlnmtabrsuyyoz.supabase.co

# Secret key (server / scripts only — never NEXT_PUBLIC_)
# Copy "service_role" from Dashboard → Settings → API (Reveal)
SUPABASE_SECRET_KEY=
SUPABASE_API_KEY=

# Publishable / anon key (Dashboard → Settings → API → anon / publishable)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# First owner bootstrap at /admin/setup/
CMS_BOOTSTRAP_SECRET=

# Optional: CLI admin  →  CMS_ADMIN_EMAIL=… CMS_ADMIN_PASSWORD=… npm run create:cms-admin
# CMS_ADMIN_EMAIL=you@example.com
# CMS_ADMIN_PASSWORD=

# Optional: psql migrations
# DATABASE_URL=postgresql://postgres.dksqshrlnmtabrsuyyoz:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
