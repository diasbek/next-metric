# Copy into Hostinger / .env.local (do not commit secrets)
# Project: https://supabase.com/dashboard/project/ginhgueucvaqxhphplmy
#
# Indexing: only https://metric.graphics is indexable in production.
# Staging (metric.nocode.uz) and local stay noindex via isIndexableDeployment().
# Never set NEXT_PUBLIC_ALLOW_INDEXING=true on staging.

NEXT_PUBLIC_SITE_URL=https://metric.nocode.uz
NEXT_PUBLIC_CONTACT_EMAIL=hello@metric.agency
# Production Hostinger example:
# NEXT_PUBLIC_SITE_URL=https://metric.graphics

# Runtime server prefers SUPABASE_* (not NEXT_PUBLIC_*) so Hostinger env wins
SUPABASE_URL=https://ginhgueucvaqxhphplmy.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://ginhgueucvaqxhphplmy.supabase.co

SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=
SUPABASE_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

CMS_BOOTSTRAP_SECRET=
CMS_ADMIN_EMAIL=admin@minim.uz
CMS_ADMIN_PASSWORD=change-me-strong-password
