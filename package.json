{
  "name": "next-metric",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "scripts": {
    "dev": "node scripts/next-cli.cjs dev",
    "postinstall": "node scripts/patch-brace-expansion.cjs",
    "prebuild": "node scripts/generate-manifest.js",
    "generate:og": "tsx scripts/generate-og-statics.mjs",
    "build": "node scripts/next-cli.cjs build --webpack",
    "start": "node scripts/next-cli.cjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:manifest": "node scripts/generate-manifest.js",
    "generate:icons": "node scripts/generate-icons.js",
    "seed:cms": "tsx scripts/seed-cms.ts",
    "seed:metric": "tsx scripts/seed-metric-home.ts",
    "migrate:case-images": "tsx scripts/migrate-case-images-to-storage.ts",
    "check:metric-env": "tsx scripts/check-metric-env.ts",
    "create:cms-admin": "tsx scripts/create-cms-admin.ts",
    "db:migrations:bundle": "tsx scripts/apply-migrations.ts --bundle",
    "db:migrate": "tsx scripts/apply-migrations.ts",
    "cms:migrate-content": "tsx scripts/cms-migrate-content.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next/swc-wasm-nodejs": "16.4.5",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "formik": "^2.4.9",
    "leaflet": "^1.9.4",
    "next": "16.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-leaflet": "^5.0.0",
    "react-toastify": "^11.1.0",
    "resend": "^6.20.0",
    "swiper": "^14.1.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/og": "^1.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "sharp": "$sharp",
    "brace-expansion": "5.0.12",
    "source-map-js": "1.2.2",
    "js-yaml": "4.3.2",
    "zod": "4.6.7",
    "satori": "0.33.5",
    "tinypool": "2.1.2",
    "vite": "7.3.7",
    "minimatch": "11.0.5",
    "fflate": "0.8.3"
  }
}
